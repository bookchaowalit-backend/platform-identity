{
  "$schema": "./schema/book-platform.contract.v1.schema.json",
  "schema_version": "book-platform.contract.v1",
  "platform_id": "identity",
  "repository": "platform-identity",
  "status": "scaffolded",
  "api_version": "v1",
  "data_owner": "platform-identity",
  "capabilities": [
    "authentication",
    "tenant",
    "membership",
    "rbac",
    "api-key"
  ],
  "depends_on": [],
  "current_implementation": {
    "repository": "platform-empire",
    "source_path": "services/platform/platform_api/routes.py",
    "source_paths": [
      "services/platform/platform_api/routes.py",
      "src/empire_platform/jwks.py",
      "services/platform/migrations/0001_platform_core.sql",
      "services/platform/migrations/0003_authorization_decision_point.sql"
    ],
    "source_status": "adjacent-domain-repository"
  },
  "migration": {
    "compatibility_adapter": "required",
    "shadow_parity": "pending",
    "cutover": "pending",
    "rollback": "required"
  },
  "migration_gates": [
    "tenant isolation",
    "credential rotation",
    "session parity"
  ],
  "surface_doc": "docs/CONTRACT-SURFACE.md",
  "interfaces": [
    {
      "id": "identity.http.jwks",
      "kind": "http",
      "direction": "provides",
      "name": "GET /.well-known/jwks.json: RS256 verification keys (RFC 7517, kid = RFC 7638 thumbprint)",
      "status": "pilot",
      "source": "src/empire_platform/jwks.py",
      "auth": "public"
    },
    {
      "id": "identity.http.authz-decide",
      "kind": "http",
      "direction": "provides",
      "name": "POST /v1/authz/decide: recorded allow/deny/require_approval decision for the caller's workspace",
      "status": "pilot",
      "source": "services/platform/platform_api/routes.py",
      "auth": "bearer JWT, audience platform-api"
    },
    {
      "id": "identity.table.workspace-rbac",
      "kind": "table",
      "direction": "provides",
      "name": "identities, workspaces, memberships, roles, role_permissions, membership_roles, policies, delegations (forced RLS on app.workspace_id)",
      "status": "pilot",
      "source": "services/platform/migrations/0001_platform_core.sql"
    },
    {
      "id": "identity.http.token-exchange",
      "kind": "http",
      "direction": "provides",
      "name": "POST /v1/token: RFC 8693-shaped exchange of a provider id_token, API key or empire-mcp token for an audience-bound access token",
      "status": "planned",
      "source": "src/empire_platform/token_exchange.py",
      "auth": "subject token"
    },
    {
      "id": "identity.http.workspace-admin",
      "kind": "http",
      "direction": "provides",
      "name": "/v1/workspaces, members, roles, api-keys and delegations administration",
      "status": "planned",
      "source": "none",
      "auth": "bearer JWT with identity.*:admin"
    }
  ]
}
